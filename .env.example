# Backend. Leave empty in local dev: the Vite dev server proxies /api and /socket.io to :8080.
# In production VITE_SOCKET_URL must be the backend host (Firebase Hosting does not proxy WebSockets).
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080

# Default board view: 2D or 3D (a player's toggle overrides it).
VITE_BOARD_VIEW=2D
